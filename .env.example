# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Developers -> Suas integracoes -> Credenciais)
# comece com as de TESTE (sandbox), troque para producao soh no final
MERCADOPAGO_ACCESS_TOKEN=

# Web push (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# URL publica do app (Vercel preenche sozinho em producao,
# mas defina aqui para rodar local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
